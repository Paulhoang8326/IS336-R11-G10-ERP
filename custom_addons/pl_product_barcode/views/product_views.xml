<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.form.pl.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_open_label_layout']" position="before">
                <button
                    name="action_pl_generate_barcode"
                    string="Generate Barcode"
                    type="object"
                    invisible="barcode or product_variant_count &gt; 1 or type in ('service', 'combo')"
                />
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form.pl.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_open_label_layout']" position="before">
                <button
                    name="action_pl_generate_barcode"
                    string="Generate Barcode"
                    type="object"
                    invisible="barcode or type in ('service', 'combo')"
                />
            </xpath>
        </field>
    </record>

    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.easy.edit.pl.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_open_label_layout']" position="before">
                <button
                    name="action_pl_generate_barcode"
                    string="Generate Barcode"
                    type="object"
                    invisible="barcode or type in ('service', 'combo')"
                />
            </xpath>
        </field>
    </record>
</odoo>
