<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_barcodes_read_form" model="ir.ui.view">
        <field name="name">stock.barcodes.read.form.camera</field>
        <field name="model">wiz.stock.barcodes.read</field>
        <field name="inherit_id" ref="stock_barcodes.view_stock_barcodes_read_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('barcode-info')]/span[hasclass('fa-barcode')]" position="before">
                <widget name="pl_barcode_camera_button" />
            </xpath>
        </field>
    </record>
</odoo>
