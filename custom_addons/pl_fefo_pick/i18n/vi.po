msgid ""
"%(product)s, lot %(lot)s: %(remaining)s%% shelf life left on %(date)s, "
"customer requires %(required)s%%"
msgstr ""
"%(product)s, lô %(lot)s: còn %(remaining)s%% hạn dùng vào ngày %(date)s, khách yêu cầu %(required)s%%"

#. module: pl_fefo_pick
#: model:ir.model,name:pl_fefo_pick.model_res_partner
msgid "Contact"
msgstr "Liên hệ"

#. module: pl_fefo_pick
#: model:ir.model,name:pl_fefo_pick.model_stock_lot
msgid "Lot/Serial"
msgstr "Số lô/sê-ri"

#. module: pl_fefo_pick
#: model:ir.model.fields,help:pl_fefo_pick.field_res_partner__pl_min_shelf_life_pct
#: model:ir.model.fields,help:pl_fefo_pick.field_res_users__pl_min_shelf_life_pct
#: model:ir.model.fields,help:pl_fefo_pick.field_sale_order__pl_min_shelf_life_pct
#: model:ir.model.fields,help:pl_fefo_pick.field_stock_picking__pl_min_shelf_life_pct
msgid ""
"Lots delivered to this customer must still have at least this share of the "
"product's expiration time left on the scheduled delivery date. 0 means no "
"requirement. Delivery addresses use the value of their company."
msgstr ""
"Lô giao cho khách này phải còn ít nhất phần này của hạn dùng sản phẩm vào ngày giao dự kiến. 0 là không yêu cầu. Địa chỉ giao hàng dùng mức của công ty mẹ."

#. module: pl_fefo_pick
#: model:ir.model.fields,field_description:pl_fefo_pick.field_res_partner__pl_min_shelf_life_pct
#: model:ir.model.fields,field_description:pl_fefo_pick.field_res_users__pl_min_shelf_life_pct
#: model:ir.model.fields,field_description:pl_fefo_pick.field_sale_order__pl_min_shelf_life_pct
#: model:ir.model.fields,field_description:pl_fefo_pick.field_stock_picking__pl_min_shelf_life_pct
msgid "Min. Shelf Life at Delivery (%)"
msgstr "Hạn dùng còn lại tối thiểu khi giao (%)"

#. module: pl_fefo_pick
#. odoo-python
#: code:addons/pl_fefo_pick/models/res_partner.py:0
msgid "Min. Shelf Life at Delivery must be between 0 and 100%."
msgstr "Hạn dùng còn lại tối thiểu khi giao phải từ 0 đến 100%."

#. module: pl_fefo_pick
#: model:ir.model,name:pl_fefo_pick.model_stock_quant
msgid "Quants"
msgstr "Quant"

#. module: pl_fefo_pick
#: model:ir.model.fields,field_description:pl_fefo_pick.field_stock_lot__pl_remaining_shelf_life_pct
msgid "Remaining Shelf Life (%)"
msgstr "Hạn dùng còn lại (%)"

#. module: pl_fefo_pick
#: model:ir.model,name:pl_fefo_pick.model_sale_order
msgid "Sales Order"
msgstr "Đơn bán hàng"

#. module: pl_fefo_pick
#: model:ir.model.fields,help:pl_fefo_pick.field_stock_lot__pl_remaining_shelf_life_pct
msgid ""
"Share of the product's expiration time left today, negative once expired. "
"Only shown when the lot has an expiration date."
msgstr ""
"Phần hạn dùng của sản phẩm còn lại tính đến hôm nay, âm khi đã hết hạn. Chỉ hiện khi lô có ngày hết hạn."

#. module: pl_fefo_pick
#: model:ir.model,name:pl_fefo_pick.model_stock_move
msgid "Stock Move"
msgstr "Dịch chuyển kho"

#. module: pl_fefo_pick
#. odoo-python
#: code:addons/pl_fefo_pick/models/stock_picking.py:0
msgid ""
"These lots do not meet the customer's minimum shelf life at delivery. Pick other lots or unreserve and check availability again:\n"
"%s"
msgstr ""
"Các lô sau không đạt hạn dùng còn lại tối thiểu của khách khi giao. Chọn lô khác hoặc bỏ giữ hàng rồi kiểm tra tồn lại:\n"
"%s"

#. module: pl_fefo_pick
#: model:ir.model,name:pl_fefo_pick.model_stock_picking
msgid "Transfer"
msgstr "Phiếu kho"
