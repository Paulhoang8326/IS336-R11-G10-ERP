<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trip -->
    <record id="pl_delivery_trip_view_form" model="ir.ui.view">
        <field name="name">pl.delivery.trip.form</field>
        <field name="model">pl.delivery.trip</field>
        <field name="arch" type="xml">
            <form string="Delivery Trips" create="false" edit="false">
                <header>
                    <button name="action_open_maps" type="object" string="Open Google Maps" class="btn-primary"
                            icon="fa-map-marker" invisible="not maps_url"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="vehicle_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id" readonly="1"/>
                            <field name="date"/>
                            <field name="stop_count"/>
                            <field name="batch_id" invisible="not batch_id"/>
                        </group>
                        <group>
                            <field name="weight" readonly="1"/>
                            <field name="capacity_kg"/>
                            <field name="load_pct" widget="progressbar"/>
                            <field name="total_km" readonly="1"/>
                        </group>
                    </group>
                    <group string="Google Maps" invisible="not maps_links">
                        <field name="maps_segment_count"/>
                        <field name="maps_links" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <field name="stop_ids" readonly="1">
                        <list>
                            <field name="sequence"/>
                            <field name="partner_id"/>
                            <field name="address" optional="show"/>
                            <field name="picking_ids" widget="many2many_tags"/>
                            <field name="weight" sum="Total"/>
                            <field name="leg_km" sum="Total"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="return_km" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pl_delivery_trip_view_list" model="ir.ui.view">
        <field name="name">pl.delivery.trip.list</field>
        <field name="model">pl.delivery.trip</field>
        <field name="arch" type="xml">
            <list string="Delivery Trips" create="false">
                <field name="plan_id"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="stop_count"/>
                <field name="weight"/>
                <field name="load_pct" widget="progressbar"/>
                <field name="total_km"/>
                <field name="batch_id" optional="show"/>
                <field name="maps_url" column_invisible="True"/>
                <button name="action_open_maps" type="object" string="Google Maps" icon="fa-map-marker"
                        invisible="not maps_url"/>
            </list>
        </field>
    </record>

    <!-- Plan -->
    <record id="pl_delivery_plan_view_list" model="ir.ui.view">
        <field name="name">pl.delivery.plan.list</field>
        <field name="model">pl.delivery.plan</field>
        <field name="arch" type="xml">
            <list string="Delivery Plans">
                <field name="name"/>
                <field name="date"/>
                <field name="warehouse_id"/>
                <field name="trip_count"/>
                <field name="total_weight"/>
                <field name="total_km"/>
                <field name="unassigned_count"/>
                <field name="state" widget="badge" decoration-info="state == 'routed'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="pl_delivery_plan_view_form" model="ir.ui.view">
        <field name="name">pl.delivery.plan.form</field>
        <field name="model">pl.delivery.plan</field>
        <field name="arch" type="xml">
            <form string="Delivery Plans">
                <header>
                    <button name="action_compute_routes" type="object" string="Compute Routes" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_compute_routes" type="object" string="Compute Routes"
                            invisible="state != 'routed'"
                            confirm="Discard the current routes and compute them again?"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'routed'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'routed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                            <field name="road_factor" readonly="state != 'draft'"/>
                            <field name="max_stops" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="trip_count"/>
                            <field name="total_weight"/>
                            <field name="total_km"/>
                            <field name="unassigned_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trips" name="trips">
                            <field name="trip_ids" readonly="1">
                                <list>
                                    <field name="vehicle_id"/>
                                    <field name="stop_count"/>
                                    <field name="weight" sum="Total"/>
                                    <field name="capacity_kg"/>
                                    <field name="load_pct" widget="progressbar"/>
                                    <field name="total_km" sum="Total"/>
                                    <field name="maps_segment_count" optional="show"/>
                                    <field name="batch_id" optional="show"/>
                                    <field name="maps_url" column_invisible="True"/>
                                    <button name="action_open_maps" type="object" string="Google Maps"
                                            icon="fa-map-marker" invisible="not maps_url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Unassigned" name="unassigned">
                            <field name="unassigned_ids" readonly="1">
                                <list>
                                    <field name="picking_id"/>
                                    <field name="origin"/>
                                    <field name="partner_id"/>
                                    <field name="weight" sum="Total"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pl_delivery_plan_view_search" model="ir.ui.view">
        <field name="name">pl.delivery.plan.search</field>
        <field name="model">pl.delivery.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <field name="warehouse_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="routed" string="Routed" domain="[('state', '=', 'routed')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pl_delivery_plan_action" model="ir.actions.act_window">
        <field name="name">Delivery Plans</field>
        <field name="res_model">pl.delivery.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a delivery plan for a day</p>
            <p>Pick the delivery date and warehouse, then click Compute Routes to assign the ready deliveries to vehicles.</p>
        </field>
    </record>
</odoo>
