<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_pl_delivery_route" model="ir.ui.view">
        <field name="name">stock.picking.form.pl.delivery.route</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="pl_trip_id" invisible="not pl_trip_id"/>
                <field name="pl_stop_sequence" invisible="not pl_trip_id"/>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_pl_delivery_route" model="ir.ui.view">
        <field name="name">stock.picking.list.pl.delivery.route</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="pl_trip_id" optional="hide"/>
                <field name="pl_stop_sequence" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
